# Copy this file to .env and fill in real values. Never commit .env.
# All Expo public runtime env vars must be prefixed EXPO_PUBLIC_ to be
# available in client code (see https://docs.expo.dev/guides/environment-variables/).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the AI document-extraction edge function / server route. Never
# reference this from client code — it must stay server-side.
AI_EXTRACTION_API_KEY=

# Only used server-side (e.g. Supabase Edge Functions), never bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=
