# Copy this file to .env and fill in real values. Never commit .env.
# All Expo public runtime env vars must be prefixed EXPO_PUBLIC_ to be
# available in client code (see https://docs.expo.dev/guides/environment-variables/).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the extract-document Supabase Edge Function, NOT the app itself —
# set it with `supabase secrets set GEMINI_API_KEY=...`, never here. Get a
# free key (no credit card required) at https://aistudio.google.com/apikey.
# Listed here only for reference/documentation.
GEMINI_API_KEY=

# Only used server-side (e.g. Supabase Edge Functions), never bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=
